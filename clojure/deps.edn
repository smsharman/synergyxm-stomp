{:paths ["src"]
 :deps {org.clojure/clojure       {:mvn/version "1.12.5"}
        metosin/jsonista          {:mvn/version "1.0.0"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; test-only: an in-process WebSocket server for the
                       ;; connection tests (the JDK ships a client only)
                       org.java-websocket/Java-WebSocket {:mvn/version "1.5.7"}}
         :main-opts   ["-m" "cognitect.test-runner"]}}}
